{
  "kind": "collectionType",
  "collectionName": "stories",
  "info": {
    "singularName": "story",
    "pluralName": "stories",
    "displayName": "Story",
    "description": "Короткие вертикальные сюжеты в кружках над блоком новостей"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 40
    },
    "poster": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "media": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["videos", "images"]
    },
    "durationSeconds": {
      "type": "integer",
      "default": 8,
      "min": 3,
      "max": 60
    },
    "linkUrl": {
      "type": "string"
    },
    "linkLabel": {
      "type": "string",
      "maxLength": 40
    },
    "publishAt": {
      "type": "datetime"
    },
    "expiresAt": {
      "type": "datetime"
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "priority": {
      "type": "integer",
      "default": 0
    }
  }
}
