{
  "kind": "collectionType",
  "collectionName": "news_posts",
  "info": {
    "singularName": "news-post",
    "pluralName": "news-posts",
    "displayName": "News post",
    "description": "Новости, акции и анонсы, которые показываются на лендинге"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 120
    },
    "excerpt": {
      "type": "text",
      "maxLength": 220
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "kind": {
      "type": "enumeration",
      "required": true,
      "default": "news",
      "enum": ["promo", "news", "event", "announcement"]
    },
    "badgeLabel": {
      "type": "string",
      "maxLength": 32
    },
    "body": {
      "type": "richtext"
    },
    "video": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["videos"]
    },
    "linkUrl": {
      "type": "string"
    },
    "linkLabel": {
      "type": "string",
      "maxLength": 40
    },
    "publishAt": {
      "type": "datetime"
    },
    "expiresAt": {
      "type": "datetime"
    },
    "isPinned": {
      "type": "boolean",
      "default": false
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "priority": {
      "type": "integer",
      "default": 0
    }
  }
}
